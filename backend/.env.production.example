APP_NAME=Blog
APP_ENV=production
APP_KEY=base64:ここにphp artisan key:generateで生成したキーを入れる
APP_DEBUG=false
APP_URL=https://あなたのEC2ドメインまたはIP

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blog
DB_USERNAME=blog_user
DB_PASSWORD=強いパスワードを設定する

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# フロントエンド（Vercel）からのリクエストを許可するCORSの設定
FRONTEND_URL=https://あなたのVercelドメイン

ADMIN_NAME="あなたの名前"
ADMIN_EMAIL="あなたのメールアドレス"
ADMIN_PASSWORD="強いパスワードを設定する"
